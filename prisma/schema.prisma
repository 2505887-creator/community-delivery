generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  tenant
  provider
  driver
  merchant
  admin
}

enum ServiceCategory {
  plumbing
  electrical
  cleaning
  carpentry
  appliances
}

enum StoreType {
  supermarket
  pharmacy
}

enum OrderType {
  service
  store_delivery
  ride_cargo
}

enum OrderStatus {
  pending
  assigned
  en_route
  arrived
  in_progress
  completed
  cancelled
}

enum ThemePreference {
  system
  light
  dark
}

enum EmailJobStatus {
  pending
  processing
  sent
  failed
  dead_letter
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(tenant)
  createdAt    DateTime @default(now())
}

model Profile {
  id String @id @db.Uuid
  email             String
  name              String?
  role              UserRole @default(tenant)
  phone             String?
  avatarUrl         String?
  emailVerifiedAt   DateTime?
  phoneVerifiedAt   DateTime?
  timezone          String   @default("Africa/Nairobi")
  locale            String   @default("en")
  currency          String   @default("KES")
  suspendedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  preferences   UserPreferences?
  notifications Notification[]
  auditEvents   AuditEvent[] @relation("Actor")

  @@map("profiles")
}

model VerifiedPro {
  id              String          @id @default(cuid())
  userId          String?         @unique
  name            String
  avatar          String?
  category        ServiceCategory
  title           String
  rating          Float           @default(0)
  reviewCount     Int             @default(0)
  hourlyRate      Float
  isVerified      Boolean         @default(false)
  isOnline        Boolean         @default(false)
  licenseNumber   String?
  yearsExperience Int             @default(0)
  distanceMiles   Float           @default(0)
  responseTimeMin Int             @default(30)
  specialties     String[]
  badges          String[]
  phone           String
  completedJobs   Int             @default(0)
  bio             String?
  lat             Float
  lng             Float
  address         String
  createdAt       DateTime        @default(now())

  orders Order[]
}

model LocalStore {
  id                  String      @id @default(cuid())
  ownerId             String?
  name                String
  type                StoreType
  logo                String?
  coverImage          String?
  rating              Float
  reviewCount         Int
  distanceMiles       Float
  deliveryEstimateMin Int
  deliveryFee         Float
  minOrder            Float
  address             String
  isOpen              Boolean
  createdAt           DateTime    @default(now())

  items StoreItem[]
  orders Order[]
}

model StoreItem {
  id          String     @id @default(cuid())
  storeId     String
  store       LocalStore @relation(fields: [storeId], references: [id])
  name        String
  category    String
  price       Float
  unit        String
  image       String?
  inStock     Boolean
  description String?
}

model Driver {
  id                  String    @id @default(cuid())
  userId              String?   @unique
  name                String
  avatar              String?
  vehicleType         String
  vehiclePlate        String
  rating              Float     @default(0)
  completedDeliveries Int       @default(0)
  phone               String
  currentLat          Float     @default(0)
  currentLng          Float     @default(0)
  isOnline            Boolean   @default(false)
  idNumber            String?
  vehicleReg          String?
  payoutMethod        String?
  payoutInfo          Json?
  verified            Boolean   @default(false)
  verifiedAt          DateTime?
  idDocumentUrl       String?
  vehicleDocUrl       String?
  createdAt           DateTime  @default(now())

  orders Order[]
}

model Order {
  id                  String           @id @default(cuid())
  type                OrderType
  title               String
  category            String?
  status              OrderStatus      @default(pending)
  createdAt           DateTime         @default(now())

  tenantUserId        String?
  tenantName          String
  tenantPhone         String
  tenantAddress       String
  apartmentUnit       String?

  providerId          String?
  provider            VerifiedPro?     @relation(fields: [providerId], references: [id], onDelete: SetNull)

  driverId            String?
  driver              Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)

  storeId             String?
  store               LocalStore?      @relation(fields: [storeId], references: [id], onDelete: SetNull)

  subtotal            Float
  deliveryFee         Float
  serviceFee          Float
  tax                 Float
  total               Float
  paymentMethod       String
  estimatedArrivalMin Int
  urgency             String
  scheduledFor        DateTime?
  notes               String?

  tenantLat           Float?
  tenantLng           Float?

  originLat           Float?
  originLng           Float?

  currentLat          Float?
  currentLng          Float?

  assignments         OrderAssignment[]
  events              OrderEvent[]
  messages            OrderMessage[]
}


model OrderAssignment {
  id         String   @id @default(cuid())
  orderId    String
  proId      String
  driverId   String?
  assignedBy String
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  type      String
  payload   Json?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderMessage {
  id         String   @id @default(cuid())
  orderId    String
  sender     String
  senderName String
  text       String
  createdAt  DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id       String @id @default(cuid())
  userId String @unique @db.Uuid

  theme    ThemePreference @default(system)
  language String          @default("en")
  timezone String          @default("Africa/Nairobi")
  currency String          @default("KES")

  emailMarketing Boolean @default(false)
  emailProduct   Boolean @default(true)
  emailSecurity  Boolean @default(true)
  pushEnabled    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String    @id @default(cuid())
  userId String @db.Uuid
  type      String
  title     String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
 userId String @db.Uuid
  type      String
  inApp     Boolean  @default(true)
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model AuditEvent {
  id         String   @id @default(cuid())
  actorId String? @db.Uuid
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor Profile? @relation("Actor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, resourceId])
}

model EmailJob {
  id          String        @id @default(cuid())
  to          String
  template    String
  payload     Json
  status      EmailJobStatus @default(pending)

  attempts    Int           @default(0)
  maxAttempts Int           @default(5)

  scheduledAt DateTime      @default(now())
  sentAt      DateTime?
  failedAt    DateTime?

  providerId  String?
  lastError   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, scheduledAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  subject   String
  html      String
  text      String
  enabled   Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions EmailTemplateVersion[]
}


model EmailTemplateVersion {
  id         String   @id @default(cuid())
  templateId String
  version    Int
  subject    String
  html       String
  text       String
  createdAt  DateTime @default(now())

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, version])
  @@index([templateId, createdAt])
}
model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
